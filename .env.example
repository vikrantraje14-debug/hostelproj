# Reference template only. Workspace commands load backend/.env and
# frontend/.env from their respective workspace directories.

# Backend values -> backend/.env
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=
SESSION_SECRET=
DOCUMENT_STORAGE_PATH=./private-uploads
SEED_DEMO_DATA=false

# Frontend value -> frontend/.env or the frontend build environment.
VITE_API_BASE_URL=http://localhost:3000/api/v1